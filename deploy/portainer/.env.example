# Copiar a Portainer → Stack → Environment variables
# o guardar como .env junto al compose (NO subir .env a git).
#
# Arquitectura de datos:
#   Licencias     → BD licensing_ecunexo (otro stack)
#   Cliente API   → BD ecunexo (stack Cliente)
#   Facturación   → BD billing (este stack, Postgres propio)
#   Consumo: SPA Cliente → HTTP Billing.Api (VITE_BILLING_API_BASE_URL)
#   Post-SRI: Billing.Api → HTTP Cliente API (INVENTORY_EGRESS_*)

# =============================================================================
# Postgres (propio del stack Facturación)
# =============================================================================
# Dejar BILLING_CONNECTION_STRING sin definir (o no crearla en Portainer).
# El compose usa Host=postgres / Database=billing.
POSTGRES_DB=billing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_fuerte
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Override raro (p. ej. Postgres gestionado externo). No usar la BD del stack Cliente.
# Si la defines vacía, Compose trata "" como valor y rompe el fallback: no la crees.
# BILLING_CONNECTION_STRING=Host=postgres;Port=5432;Database=billing;Username=postgres;Password=...

# =============================================================================
# API
# =============================================================================
BILLING_HTTP_PORT=8081
ASPNETCORE_ENVIRONMENT=Production
# Red Docker de Nginx Proxy Manager (nombre exacto en Portainer → Networks).
# billing-api se une sola; así no se pierde al reiniciar/redeploy el stack.
PROXY_NETWORK=nginx_default
# billing-api se construye del Dockerfile (sin imagen en Docker Hub).
# En Portainer puedes quitar BILLING_IMAGE si la tenías; ya no se usa.
# Orígenes del admin SPA que llaman a Billing.Api (coma-separados).
# Ej.: http://150.136.6.60:5173 o https://admin.tudominio.com
# Localhost Vite (5173-5175) ya están permitidos en código.
CORS_ORIGINS=

# Bootstrap BD (migrate schema billing + seed catálogos)
BILLING_BOOTSTRAP_ENABLED=true
BILLING_BOOTSTRAP_MIGRATE=true
BILLING_BOOTSTRAP_SEED=true

# =============================================================================
# SRI
# =============================================================================
# true = sin SOAP real (dev/demo). false = celcer/cel reales + firma.
SRI_USE_INMEMORY=true
SRI_ENVIRONMENT=Test
# Identidad EcuNexo en celcer. En Test, si el tenant tiene otro RUC, el XML usa esto
# + la firma Infisical (mismo RUC). Estab 002 evita "establecimiento cerrado" de 001.
SRI_TEST_EMISSION_RUC=0926398074001
SRI_TEST_EMISSION_BUSINESS_NAME=Ecunexo S.A
SRI_TEST_EMISSION_MAIN_ADDRESS=Guayaquil via Daule
SRI_TEST_EMISSION_TRADE_NAME=EcuNexo
SRI_TEST_EMISSION_ESTABLISHMENT=002
SRI_TEST_EMISSION_EMISSION_POINT=001

# =============================================================================
# Infisical (firma electrónica)
# =============================================================================
# Dejar vacío si SRI_USE_INMEMORY=true y no firmas aún.
INFISICAL_BASE_URL=
INFISICAL_WORKSPACE_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_CERT_SECRET_NAME=keyfacturacion
INFISICAL_PASS_SECRET_NAME=passfacturacion

# =============================================================================
# RIDE
# =============================================================================
RIDE_PROVIDER_RUC=
RIDE_PROVIDER_LEGAL_NAME=EcuNexo
RIDE_PROVIDER_FOOTER=Documento generado por EcuNexo

# =============================================================================
# Egreso inventario → API tenant (Cliente / ecunexo_api), NO la SPA admin
# Mapea a InventoryEgress__Enabled / BaseUrl / ApiKey en la API.
# =============================================================================
# Mientras Cliente no esté desplegado: dejar ENABLED=false.
INVENTORY_EGRESS_ENABLED=false
# Base URL de ecunexo_api (sin path de egreso; la API añade la ruta).
# Ejemplos:
#   Misma red Docker: http://api:8080
#     (nombre del servicio del compose Cliente; ajusta si se llama distinto)
#   Host / IP pública: http://150.136.6.60:5088
INVENTORY_EGRESS_BASE_URL=
# Misma clave que InventoryEgress__ApiKey / INVENTORY_EGRESS_API_KEY en el stack Cliente.
INVENTORY_EGRESS_API_KEY=
