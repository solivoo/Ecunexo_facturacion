# Copiar a Portainer → Stack → Environment variables
# o guardar como .env junto al compose (NO subir .env a git).

# --- Postgres ---
POSTGRES_DB=ecunexo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_fuerte

# --- API ---
BILLING_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
BILLING_IMAGE=ecunexo/billing-api:latest

# Bootstrap BD (migrate + seed catálogos)
BILLING_BOOTSTRAP_ENABLED=true
BILLING_BOOTSTRAP_MIGRATE=true
BILLING_BOOTSTRAP_SEED=true

# --- SRI ---
# true = sin SOAP real (dev/demo). false = celcer/cel reales.
SRI_USE_INMEMORY=true
SRI_ENVIRONMENT=Test

# --- Infisical (firma electrónica) ---
# Dejar vacío si SRI_USE_INMEMORY=true y no firmas aún.
INFISICAL_BASE_URL=
INFISICAL_WORKSPACE_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_CERT_SECRET_NAME=keyfacturacion
INFISICAL_PASS_SECRET_NAME=passfacturacion

# --- RIDE ---
RIDE_PROVIDER_RUC=
RIDE_PROVIDER_LEGAL_NAME=EcuNexo
RIDE_PROVIDER_FOOTER=Documento generado por EcuNexo

# --- Inventario (opcional) ---
INVENTORY_EGRESS_ENABLED=false
INVENTORY_EGRESS_BASE_URL=
INVENTORY_EGRESS_API_KEY=
