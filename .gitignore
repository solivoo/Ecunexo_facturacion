# ==============================================================================
# .gitignore para Proyecto de Facturación Electrónica (.NET 10 / C# / SRI Ecuador)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURIDAD Y DATOS SENSIBLES (CRÍTICO)
# ------------------------------------------------------------------------------
# Archivos de configuración local con secretos reales (Infisical, DB, APIs)
appsettings*.local.json
appsettings.*.local.json
appsettings.local.json
appsettings.secrets.json
appsettings.Production.json
appsettings.Staging.json
secrets.json

# Excepciones: Mantener plantillas y archivos base de configuración
!appsettings.json
!appsettings.Development.json
!appsettings.*.sample.json
!appsettings.*.example.json
!appsettings.Infrastructure.sample.json
!Billing.Api/appsettings.Development.local.json.example

# Datos de proveedor RIDE generados dinámicamente en runtime
**/Data/ride-provider.json
!**/Data/ride-provider.json.example
!**/Data/.gitkeep

# Variables de entorno y credenciales
.env
.env.*
!.env.example
!**/.env.example
*.env
*.local
*.local.env

# Deploy local overrides
deploy/**/.env
!deploy/**/.env.example

# Certificados digitales y llaves privadas (Firma Electrónica SRI)
*.p12
*.pfx
*.pem
*.key
*.pkcs12
*.jks
*.keystore
*.crt
*.cer
*.der
# Mantener certificados de pruebas si estuvieran documentados como mock (actualmente no hay)

# ------------------------------------------------------------------------------
# 2. COMPILACIÓN Y ARTEFACTOS .NET
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
[Bb]uild/
[Pp]ackages/
_ReSharper*/
*.sublime-project
*.sublime-workspace

# NuGet
*.nupkg
*.snupkg
project.lock.json
project.assets.json
.nuget/

# Archivos de usuario y estado de solución
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog
*.DotSettings.user

# ------------------------------------------------------------------------------
# 3. ENTORNOS DE DESARROLLO (IDEs)
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.sln.iml

# JetBrains Rider
.idea/
*.sln.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# 4. BASES DE DATOS Y PERSISTENCIA LOCAL
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# ------------------------------------------------------------------------------
# 5. SISTEMA OPERATIVO Y ARCHIVOS TEMPORALES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

*.tmp
*.temp
*~
*.swp
*.swo
crashdump*
