@Billing.Api_HostAddress = http://localhost:5203

GET {{Billing.Api_HostAddress}}/api/v1/catalogs/tax-rules?code=sri.void.online
Accept: application/json

###
POST {{Billing.Api_HostAddress}}/api/v1/catalogs/tax-rules
Content-Type: application/json

{
  "description": "Anulación en línea SRI hasta el día 15 del mes siguiente.",
  "validFrom": "2027-01-01",
  "deadlineDayOfFollowingMonth": 15,
  "extendToNextWeekday": true,
  "consumerFinalCannotVoid": true,
  "consumerFinalCannotCreditNote": true
}

