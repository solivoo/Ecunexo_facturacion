    {
      "name": "C - Flujo factura",
      "item": [
        {
          "name": "20 GET verificar IVA 15%",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/catalogs/tax-rates?taxCode=2&rateCode=4&date=2024-06-01"
          }
        },
        {
          "name": "21 POST crear emisor",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('emitterId', pm.response.json().emitterId); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ruc\": \"{{emitterRuc}}\",\n  \"businessName\": \"MI EMPRESA DEMO S.A.\",\n  \"mainAddress\": \"Av. Principal 123, Quito\",\n  \"tradeName\": \"MI EMPRESA\"\n}" },
            "url": "{{baseUrl}}/api/v1/emitters"
          }
        },
        {
          "name": "22 POST asignar certificado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"serialNumber\": \"SER-DEMO-001\",\n  \"notBefore\": \"2025-01-01T00:00:00Z\",\n  \"notAfter\": \"2027-12-31T23:59:59Z\",\n  \"provider\": \"KeyVault\",\n  \"secretName\": \"cert-demo-001\",\n  \"location\": \"KeyVault\"\n}" },
            "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/certificates"
          }
        },
        {
          "name": "23 POST crear factura",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('invoiceId', pm.response.json().invoiceId); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"emitterRuc\": \"{{emitterRuc}}\",\n  \"establishment\": \"001\",\n  \"emissionPoint\": \"001\",\n  \"sequential\": \"000000001\",\n  \"issueDate\": \"2024-06-01\",\n  \"counterparty\": {\n    \"identificationType\": \"07\",\n    \"identification\": \"9999999999999\",\n    \"businessName\": \"CONSUMIDOR FINAL\",\n    \"address\": null\n  },\n  \"lines\": [\n    {\n      \"lineNumber\": 1,\n      \"description\": \"Servicio de consultoría mensual\",\n      \"quantity\": 1,\n      \"unitPrice\": 100.00,\n      \"discount\": 0,\n      \"lineTotalWithoutTax\": 100.00,\n      \"taxes\": [\n        {\n          \"taxCode\": \"2\",\n          \"rateCode\": \"4\",\n          \"rate\": 15,\n          \"taxableBase\": 100.00,\n          \"value\": 15.00\n        }\n      ]\n    }\n  ]\n}" },
            "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/invoices"
          }
        },
        {
          "name": "24 POST firmar",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/invoices/{{invoiceId}}/sign" }
        },
        {
          "name": "25 POST recepción SRI",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/invoices/{{invoiceId}}/submit-reception" }
        },
        {
          "name": "26 POST autorizar poll",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/invoices/{{invoiceId}}/authorize-poll" }
        },
        {
          "name": "27 GET estado SRI",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/emitters/{{emitterId}}/invoices/{{invoiceId}}/sri-status" }
        }
      ]
